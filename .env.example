# === Application ===
APP_NAME=sigma-analyst
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# === API Keys - Exchange ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here

OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase

BYBIT_API_KEY=your_bybit_key
BYBIT_API_SECRET=your_bybit_secret

# === API Keys - On-chain Data ===
GLASSNODE_API_KEY=your_glassnode_key
CRYPTOQUANT_API_KEY=your_cryptoquant_key

# === API Keys - AI/ML ===
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key  # Claude API

# === Database ===
POSTGRES_USER=sigma_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=sigma_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# === Pinecone (Vector DB) ===
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX_NAME=sigma-knowledge

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Security ===
SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === CORS ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# === Agent Configuration ===
AGENT_MODE=oneshot  # oneshot | monitor
AGENT_TIMEZONE=Europe/Istanbul
AGENT_LOCALE=tr-TR

# === Risk Management ===
MAX_POSITION_SIZE_PCT=0.20
MAX_LEVERAGE=3.0
MAX_DRAWDOWN_PCT=0.15

# === Monitoring ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
